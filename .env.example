# ─────────────────────────────────────────────────────────────────────────────
#  Konstructz blog admin
#
#  Copy this file to `.env.local` for local dev (Vite auto-loads it):
#    cp .env.example .env.local
#  …then paste the two values from your Supabase project (Project Settings →
#  API). The anon key is safe to ship to the browser — row-level security
#  guards every write.
#
#  For Hostinger production: set both vars in hPanel → Hosting → Advanced →
#  Environment Variables, then trigger a fresh `npm run build`. Vite inlines
#  them at build time, so a rebuild is required when either value changes.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://hzzcatcehqvpukfxyvuc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh6emNhdGNlaHF2cHVrZnh5dnVjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzMjc4MTksImV4cCI6MjA5NzkwMzgxOX0.mR9qlSiku6cx2h9M5sILwPZEBGvhCA4N-VHZz56ODS4

# Ecwid Storefront public token (read-only). Enables SKU-based "Add to Cart"
# on Typhon product pages. Found in Ecwid: Control Panel → Apps → API keys.
# Starts with "public_". Leave blank to keep Add-to-Cart hidden.
VITE_ECWID_PUBLIC_TOKEN=CJX5CgmtTCQLgpuK97UWxPl7D4J6eldrsenn1NzN

# ─────────────────────────────────────────────────────────────────────────────
#  Product source (e-commerce framework sites)
#
#  Leave unset (or "supabase") on the MASTER / admin site — products are read
#  live from Supabase. On a deployed e-commerce framework site, set:
#      VITE_PRODUCTS_SOURCE=local
#  …so the public pages read the synced catalog written by the sync receiver
#  (default /data/products.json) and use that site's own local image paths.
#  No live Supabase reads, no Supabase image bandwidth.
# ─────────────────────────────────────────────────────────────────────────────
VITE_PRODUCTS_SOURCE=supabase
# Optional override for where the local catalog lives (must be web-served):
# VITE_PRODUCTS_LOCAL_URL=/data/products.json

# ─────────────────────────────────────────────────────────────────────────────
#  Contact / quote email endpoint (receiver/send.php on Hostinger).
#  When a visitor sends a message it is stored in Supabase AND POSTed here to be
#  emailed to the Hostinger inbox. Leave blank to store-only (no email).
#  Example: https://konstructz.com/send/send.php
# ─────────────────────────────────────────────────────────────────────────────
VITE_LEADS_EMAIL_ENDPOINT=
