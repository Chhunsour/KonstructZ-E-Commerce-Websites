# SPA routing for BrowserRouter (clean URLs, no #/).
# Serve real files/folders as-is. For app routes, first try the prerendered
# SEO snapshot (dist/prerendered/<route>/index.html — same app bundle plus
# correct per-page <head> for crawlers that don't run JS). Anything left
# falls back to spa-shell.html (index.html without the homepage canonical),
# so unknown URLs don't declare themselves duplicates of the homepage.
# All rewrites are internal — visitor URLs never change.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # /media was renamed to /blog — permanent redirect so old links and any
  # indexed /media URLs transfer cleanly.
  RewriteRule ^media$ /blog [R=301,L]
  RewriteRule ^media/(.+)$ /blog/$1 [R=301,L]

  # /blog has a real static asset folder, so handle the route explicitly
  # before Apache treats it as a directory and returns 403 for /blog/.
  RewriteRule ^blog/?$ /prerendered/blog/index.html [L]

  # 1) Known route → prerendered snapshot. If the snapshot file doesn't
  #    exist, the rewritten URL re-enters these rules and lands on the SPA
  #    fallback below (the /prerendered/ guard prevents a rewrite loop).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/prerendered/
  RewriteRule ^(.+)$ /prerendered/$1/index.html [L]

  # 2) SPA fallback for everything else (unknown/new routes).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /spa-shell.html [L]
</IfModule>

# ── Text compression (no-op if the module is missing) ──────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf application/font-woff
</IfModule>

# ── Browser caching ─────────────────────────────────────────────────────────
# Vite JS/CSS under /assets/ are content-hashed → safe to cache forever.
# Media files keep their names when replaced (uploads sync), so they get a
# shorter window. HTML is never cached: routing + prerendered SEO must stay
# fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/gif   "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon  "access plus 30 days"
  ExpiresByType video/mp4   "access plus 30 days"
  ExpiresByType video/webm  "access plus 30 days"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType font/woff   "access plus 1 year"
  ExpiresByType font/ttf    "access plus 1 year"
  ExpiresByType text/css    "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html   "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
